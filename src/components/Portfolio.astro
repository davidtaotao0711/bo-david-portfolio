---
import Header from './Header.astro';
import Photo from './Photo.astro';
import { projects, colorProjects, themeProjects } from '../data/projects';
import { photoKey } from '../lib/arrangements';
import { asset } from '../lib/images';
import { galleryRuns } from '../lib/gallery-layout';
import { indexCanvas } from '../lib/index-layout';
import { profile } from '../data/profile';
import { stripBase, withBase } from '../lib/base-path';
import { imageUrl } from '../lib/images';
const base = import.meta.env.BASE_URL;
const url = (path: string) => withBase(path, base);
const currentPath = stripBase(Astro.url.pathname, base).replace(/\/$/, '');
const currentProject = projects.find(project => `/${project.slug}` === currentPath);
---
<Header />
<main id="main" tabindex="-1"></main>
{([['color', colorProjects], ['theme', themeProjects]] as const).map(([arrangement, groups]) => <>
<template id={`overview-${arrangement}-template`}>
  <div class="archive overview gallery-sheet" aria-label="Overview — all photographs">
    {groups.map((project, p) => <section class="gallery-project" aria-label={project.title}>
      {galleryRuns(project).map(run => <div class="gallery-run" data-orientation={run.orientation}>
        {run.slots.map(slot => {
          if (slot.kind === 'blank') return <span class="gallery-cell gallery-blank" aria-hidden="true"></span>;
          const i = project.images.findIndex(image => image.id === slot.id);
          const image = project.images[i];
          return <a class="archive-image gallery-cell" href={url(`/${project.slug}?s=${i}&sort=${arrangement}`)} data-project={project.slug} data-image={i} data-photo={photoKey(image)} data-thumb={imageUrl(asset(image),320,'webp',base)} id={`photo-${project.slug}-${image.id}`} aria-label={`${project.title}, image ${i + 1}`}>
            <Photo image={image} eager={p === 0 && i < 10} />
          </a>;
        })}
      </div>)}
    </section>)}
  </div>
</template>
<template id={`grid-${arrangement}-template`}>
  <div class="archive index-grid index-layout" aria-label="Index — projects">
    {indexCanvas(groups,arrangement).layout!.map((slot, p) => {
      if(slot.kind==='blank')return <span class="index-blank" style={`aspect-ratio:${slot.orientation==='portrait'?'2/3':'3/2'}`} aria-hidden="true"></span>;
      const project=groups.find(project=>project.id===slot.id)!;
      return <>
      <a class="archive-image project-cover" href={url(`/${project.slug}?s=${project.images.findIndex(i => i.id === project.cover)}&sort=${arrangement}`)} data-project={project.slug} data-photo={photoKey(project.images.find(i => i.id === project.cover)!)} data-thumb={imageUrl(asset(project.images.find(i => i.id === project.cover)!),320,'webp',base)} id={`photo-${project.slug}-${project.cover}`} aria-label={project.title}>
        <Photo image={project.images.find(i => i.id === project.cover)!} thumbnail={false} eager={p < 3} />
        <span class="cover-caption">{project.title}</span>
      </a>
    </>;})}
  </div>
</template>
</>)}
<template id="information-template">
  <section class="information" aria-label="About BO DAVID">
    <h1>{profile.name}</h1>
    <p>{profile.role}<br />{profile.location}</p>
    <p class="contact-links">
      {profile.email ? <a href={`mailto:${profile.email}`}>Email</a> : <span title="Contact details forthcoming">Email</span>}
      {profile.instagram ? <a href={profile.instagram} target="_blank" rel="noopener noreferrer">Instagram</a> : <span title="Profile forthcoming">Instagram</span>}
      {profile.xiaohongshu ? <a href={profile.xiaohongshu} target="_blank" rel="noopener noreferrer">Xiaohongshu</a> : <span title="Profile forthcoming">Xiaohongshu</span>}
    </p>
    <p class="introduction">{profile.introduction}</p>
  </section>
</template>
<template id="viewer-template">
  <section class="viewer" aria-label="Project viewer">
    <header class="viewer-header"><h1 id="project-title"></h1><a id="close-viewer" href={url('/?mode=grid')}>Close</a></header>
    <div class="image-stage">
      <div id="current-photo"></div>
      <button class="image-hit previous-image" aria-label="Previous image"></button>
      <button class="image-hit next-image" aria-label="Next image"></button>
    </div>
    <nav class="project-navigation" aria-label="Adjacent projects">
      <a id="previous-project">Prev</a><a id="next-project">Next</a>
    </nav>
    <p class="sr-only" id="image-status" aria-live="polite" aria-atomic="true"></p>
  </section>
</template>
<noscript><div class="archive index-grid">
  {currentProject ? currentProject.images.map(image => <Photo image={image} thumbnail={false} />) : colorProjects.map(project => <a href={url(`/${project.slug}?s=0`)}><Photo image={project.images.find(i => i.id === project.cover)!} thumbnail={false} /></a>)}
  <p>Enable JavaScript to browse image sequences and the contact sheet.</p>
</div><style>.photo img{opacity:1}</style></noscript>
<script>import '../scripts/portfolio';</script>
